# 이 파일은 "변수 이름 목록"입니다. 실제 값은 .env에만 적고, .env는 커밋하지 않습니다.
# 값은 "=" 바로 뒤에 붙여 쓰고, 공백·따옴표는 쓰지 않습니다. 수정 후에는 개발 서버를 다시 시작합니다.

# ── 입장 ─────────────────────────────────────────
# 공용 접속 코드 (직원끼리 공유, 서버 전용). 외부에 알려지면 즉시 바꿉니다.
ACCESS_CODE=
# 통과 쿠키 서명용 비밀 값 (긴 무작위 문자열, 서버 전용)
SESSION_SECRET=

# ── 카카오 (https://developers.kakao.com → 내 애플리케이션 → 앱 키) ──
# 카카오 REST API 키: 주소→좌표, 자차 길찾기 (서버 전용)
KAKAO_REST_API_KEY=
# 카카오 JavaScript 키: 지도 표시용. 브라우저에 들어가는 유일한 예외라
# 카카오 개발자 설정 → 플랫폼 → Web에 사이트 주소(http://localhost:3000, 배포 주소)를 꼭 등록
NEXT_PUBLIC_KAKAO_JS_KEY=

# ── 공공데이터포털 (https://www.data.go.kr) ──
# 계정당 인증키 하나를 승인받은 모든 API(기상청 단기예보, 부산버스정보시스템 등)에 함께 씁니다.
# 마이페이지 → 데이터활용 → Open API에서 확인하는 일반 인증키 중 Decoding 키 (서버 전용)
# 지금은 날씨(nice 기능)에만 쓰고, 대중교통 경로는 카카오맵 API(KAKAO_REST_API_KEY)로 처리합니다.
DATA_GO_KR_SERVICE_KEY=
