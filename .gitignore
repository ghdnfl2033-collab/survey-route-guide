# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# 삭제 대기 파일 보관 폴더 (사용자가 직접 확인 후 삭제)
/trash-can/

# typescript
*.tsbuildinfo
next-env.d.ts

# 예시 파일(변수 이름만 있고 값은 비어 있음)은 올린다
!.env.example

# 개발 도구 상태·로컬 설정·백업 (올리지 않음)
/.bkit/
/.claude/
*.zip

# 내부 점검 메모 (공개 저장소에는 올리지 않음)
/CHECK.md
/SECURITY-REVIEW.md
